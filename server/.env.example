PORT=5000
CLIENT_URL=http://localhost:3000
MONGODB_URI=mongodb://localhost:27017/visionbridge

# AI — Gemini Vision (FREE tier)
# Get your free key at: https://aistudio.google.com/apikey
# Free limits: 15 req/min · 1,500 req/day — no credit card required
GEMINI_API_KEY=your_gemini_api_key_here

# Optional — pin a specific Gemini model (leave blank to auto-select)
# The server tries models in order until one works:
#   gemini-2.0-flash → gemini-1.5-flash → gemini-2.0-flash-lite
# Find available models: https://aistudio.google.com/app/prompts
# GEMINI_MODEL=gemini-2.0-flash

# Maps
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Firebase Auth & Notifications
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PRIVATE_KEY=your_firebase_private_key
FIREBASE_CLIENT_EMAIL=your_firebase_client_email

# ── WhatsApp Business Cloud API (Emergency SOS alerts) ──────────────
# The temporary token shown in the Meta dashboard expires after 24 hours
# and every SOS alert then fails with OAuth code 190. Use a System User
# token (Business Settings → System Users → Generate token, with the
# whatsapp_business_messaging permission) so it does not expire.
# Verify at any time — this sends no message:
#   GET /api/emergency/whatsapp/status
WHATSAPP_ACCESS_TOKEN=your_whatsapp_system_user_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_API_VERSION=v18.0

# Business-initiated messages (nobody replied in the last 24 hours —
# which is the normal case for an emergency) must use an approved
# template. Leave blank only while testing inside the 24-hour window.
# The template body must take 4 parameters, in this order:
#   {{1}} user name  {{2}} time  {{3}} coordinates  {{4}} map link
WHATSAPP_EMERGENCY_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en

# Signing key for login tokens. Without it the server falls back to a
# shared default, so set a real secret before deploying.
JWT_SECRET=your_jwt_secret
